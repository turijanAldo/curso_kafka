<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nexus.kafka</groupId>
  <artifactId>kafka-lab-nivel-3</artifactId>
  <version>1.3.0</version>
  <packaging>jar</packaging>

  <name>Kafka Lab Nivel 3 - Cluster Multi-Broker</name>
  <description>
    Nivel 3 del laboratorio Kafka. Agrega soporte para cluster de 3 brokers y las clases:
      - nivel3.ClusterAnalyzer      : analisis programatico del cluster via AdminClient
      - nivel3.LoadBalancedProducer : producer que demuestra distribucion de carga entre brokers
      - nivel3.ThroughputBenchmark  : benchmark multi-thread con metricas de latencia
    Incluye todas las clases de los Niveles 1 y 2.
  </description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kafka.version>4.0.0</kafka.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <dependencies>
    <!-- Cliente Kafka: producer, consumer y AdminClient -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>${kafka.version}</version>
    </dependency>

    <!-- SLF4J: necesario en runtime para el logging interno de kafka-clients -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>

      <!--
        Fat JAR: empaqueta todas las dependencias.
        Todas las clases se ejecutan con:
          "%JAVA_HOME%\bin\java" -cp target\kafka-lab-nivel-3-1.3.0.jar com.nexus.kafka.nivelX.Clase [args]
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.nexus.kafka.nivel3.ClusterAnalyzer</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

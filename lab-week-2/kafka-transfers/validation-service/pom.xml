<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================ -->
    <!-- MÓDULO: validation-service                                         -->
    <!--                                                                    -->
    <!-- Rol: Primer consumidor del Saga. Valida que las cuentas existen   -->
    <!-- y que el monto es positivo. Publica VALIDATED o FAILED.           -->
    <!-- Puerto: 8081                                                       -->
    <!-- Sin endpoints REST — es un consumidor/productor puro de Kafka.    -->
    <!-- Consumer Group: validation-group                                   -->
    <!-- ================================================================ -->

    <parent>
        <groupId>com.lab</groupId>
        <artifactId>kafka-transfers</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>validation-service</artifactId>
    <packaging>jar</packaging>
    <name>validation-service</name>

    <dependencies>

        <!-- JPA — para consultar la tabla accounts y escribir en processed_events -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Kafka — consume transfer.requested, publica transfer.validated / transfer.failed -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- MySQL Driver JDBC -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway Core -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway MySQL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Módulo common — eventos Kafka, enums, constantes -->
        <dependency>
            <groupId>com.lab</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- H2 — base de datos en memoria para tests de integración ligeros -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            NOTA: Este servicio NO tiene spring-boot-starter-web intencionalmente.
            No expone endpoints HTTP. Es un consumer/producer puro de Kafka.
            Agregar web innecesariamente aumenta el tiempo de arranque y la
            superficie de ataque del servicio.
        -->

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>

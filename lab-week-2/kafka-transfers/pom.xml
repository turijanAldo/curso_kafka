<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================ -->
    <!-- POM PADRE — kafka-transfers                                        -->
    <!--                                                                    -->
    <!-- Rol: coordinar los módulos hijos, centralizar versiones.           -->
    <!-- NO produce JAR propio (packaging = pom).                           -->
    <!-- Todos los módulos hijos heredan de aquí.                           -->
    <!-- ================================================================ -->

    <groupId>com.lab</groupId>
    <artifactId>kafka-transfers</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>kafka-transfers</name>
    <description>
        Lab Week 2 — Sistema de Transferencias Asíncronas con Kafka + Idempotencia.
        Patrón: Choreography-based Saga en 4 microservicios Spring Boot.
    </description>

    <!-- ================================================================ -->
    <!-- MÓDULOS HIJOS                                                       -->
    <!-- Maven los compila en este orden (respeta dependencias internas).   -->
    <!-- ================================================================ -->
    <modules>
        <module>common</module>
        <module>transfer-api</module>
        <module>validation-service</module>
        <module>account-service</module>
        <module>status-service</module>
    </modules>

    <!-- ================================================================ -->
    <!-- VERSIONES CENTRALIZADAS                                             -->
    <!-- Cambiar aquí afecta a todos los módulos hijos.                    -->
    <!-- ================================================================ -->
    <properties>
        <!-- Compilador -->
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot — versión LTS con soporte hasta 2025 -->
        <spring-boot.version>3.3.4</spring-boot.version>

        <!-- Librerías de terceros -->
        <mysql.version>8.3.0</mysql.version>
        <flyway.version>10.15.0</flyway.version>
        <lombok.version>1.18.34</lombok.version>
        <jackson.version>2.17.2</jackson.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
    </properties>

    <!-- ================================================================ -->
    <!-- DEPENDENCIA DE SPRING BOOT BOM                                     -->
    <!-- Importar el BOM (Bill of Materials) de Spring Boot permite que     -->
    <!-- todos los starters usen versiones compatibles entre sí sin         -->
    <!-- tener que declararlas manualmente.                                  -->
    <!-- ================================================================ -->
    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot BOM — importar como POM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Módulo Common propio — disponible para todos los hijos -->
            <dependency>
                <groupId>com.lab</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MySQL Driver JDBC -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- Flyway Core — migraciones de schema -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Flyway MySQL — soporte específico para MySQL 8 -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-mysql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Lombok — reduce boilerplate (@Data, @Builder, @Slf4j) -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Jackson — serialización/deserialización JSON -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Jackson soporte para tipos de Java 8+ (Instant, LocalDate, etc.) -->
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ================================================================ -->
    <!-- DEPENDENCIAS COMUNES A TODOS LOS MÓDULOS                           -->
    <!-- Se heredan automáticamente sin declararlas en cada hijo.           -->
    <!-- ================================================================ -->
    <dependencies>

        <!-- Lombok disponible en todos los módulos -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Tests — JUnit 5 incluido por Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-kafka-test — @EmbeddedKafka y KafkaTestUtils para todos los módulos -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Awaitility — polling con timeout en lugar de Thread.sleep() -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================================================================ -->
    <!-- BUILD — PLUGIN DE SPRING BOOT                                       -->
    <!-- Centralizar la config del plugin de Spring Boot para que los       -->
    <!-- módulos con @SpringBootApplication puedan generar fat JARs         -->
    <!-- ejecutables con: mvn package                                        -->
    <!-- ================================================================ -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <!-- Excluir Lombok del JAR final (es solo compile-time) -->
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================ -->
    <!-- MÓDULO: transfer-api                                               -->
    <!--                                                                    -->
    <!-- Rol: Gateway REST del sistema. Recibe peticiones HTTP del cliente, -->
    <!-- las persiste en DB y publica el primer evento Kafka del Saga.     -->
    <!-- Puerto: 8080                                                       -->
    <!-- Endpoints: POST /transfers   → inicia una transferencia           -->
    <!--            GET  /transfers/{id} → consulta el estado              -->
    <!-- ================================================================ -->

    <parent>
        <groupId>com.lab</groupId>
        <artifactId>kafka-transfers</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>transfer-api</artifactId>
    <packaging>jar</packaging>
    <name>transfer-api</name>

    <dependencies>

        <!-- Web MVC — expone los endpoints REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation — valida @NotNull, @Positive en TransferRequest -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JPA + Hibernate — ORM para la tabla transactions -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Kafka — para publicar TransferRequestedEvent -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- MySQL Driver JDBC -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway Core — ejecuta las migraciones SQL al arrancar -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway MySQL — soporte específico para MySQL 8 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Redis — caché de estado de transferencias (Bonus A) -->
        <!-- Incluye: spring-data-redis, lettuce (cliente async), jackson serializer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Módulo common — eventos Kafka, enums, constantes -->
        <dependency>
            <groupId>com.lab</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Genera fat JAR ejecutable con: mvn package -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>

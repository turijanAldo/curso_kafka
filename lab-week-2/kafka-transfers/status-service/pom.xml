<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================ -->
    <!-- MÓDULO: status-service                                             -->
    <!--                                                                    -->
    <!-- Rol: Tracker del Saga. Escucha todos los eventos y actualiza      -->
    <!-- el estado de la transferencia en la tabla transactions.           -->
    <!-- Puerto: 8083                                                       -->
    <!-- Tiene endpoint REST: GET /transfers/{id}/status                   -->
    <!-- Consumer Group: status-group                                       -->
    <!-- ================================================================ -->

    <parent>
        <groupId>com.lab</groupId>
        <artifactId>kafka-transfers</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>status-service</artifactId>
    <packaging>jar</packaging>
    <name>status-service</name>

    <dependencies>

        <!-- Web MVC — expone GET /transfers/{id}/status -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA — actualiza la tabla transactions con cada cambio de estado -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Kafka — consume transfer.validated, transfer.debited,
             transfer.credited, transfer.failed, transfer.compensated -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- MySQL Driver JDBC -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway Core -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway MySQL -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Módulo common — eventos Kafka, enums, constantes -->
        <dependency>
            <groupId>com.lab</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
